              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">String matchNrStr = vars.get(&quot;flightID_matchNr&quot;)
if (matchNrStr != null &amp;&amp; matchNrStr.isInteger()) {
    int count = matchNrStr.toInteger()
    for (int i = 1; i &lt;= count; i++) {
        sampler.addArgument(&quot;flightID&quot;, vars.get(&quot;flightID_&quot; + i))
    }
}</stringProp>
              <stringProp name="parameters"></stringProp>
